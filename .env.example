# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ledgerline

# JWT
JWT_SECRET=change-me-to-a-long-random-secret-in-production
JWT_EXPIRES_IN=24h

# HMAC for audit log integrity
AUDIT_HMAC_SECRET=change-me-to-another-long-random-secret

# Server
PORT=3000
NODE_ENV=development

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
